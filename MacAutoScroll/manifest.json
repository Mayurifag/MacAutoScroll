{
  "manifest_version": 3,
  "name": "Mac AutoScroll",
  "version": "2.0.0",
  "description": "Replica of the AutoScroll feature from Chrome on Windows for Mac and Linux",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "settings.html",
    "default_title": "Mac AutoScroll",
    "default_icon": {
      "16": "img/16.png",
      "32": "img/32.png",
      "48": "img/48.png",
      "128": "img/128.png"
    }
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "img/16.png",
    "32": "img/32.png",
    "48": "img/48.png",
    "64": "img/64.png",
    "96": "img/96.png",
    "128": "img/128.png"
  }
}
